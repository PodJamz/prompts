{
    "mcpServers": {
      "whatsapp": {
        "command": "/opt/homebrew/bin/uv",
        "args": [
          "--directory",
          "/tmp/whatsapp-mcp/whatsapp-mcp-server",
          "run",
          "main.py"
        ]
      },
      "mcp-installer": {
        "command": "npx",
        "args": [
          "@anaisbetts/mcp-installer"
        ]
      },
      "mcpsx": {
        "command": "npx",
        "args": [
          "-y",
          "@jasonkneen/mcpx",
          "run"
        ]
      },
      "21st dev": {
        "command": "npx",
        "args": [
          "-y",
          "@smithery/cli@latest",
          "run",
          "@21st-dev/magic-mcp",
          "--config",
          "{\"TWENTY_FIRST_API_KEY\":\"d3d9a02c6cb71da48edabb518dfea49cec0cf9a112c1436737e5a589812187c4\"}"
        ]
      },
      "cursor-rules-mcp": {
        "command": "npx",
        "args": [
          "-y",
          "cursor-rules-mcp"
        ]
      },
      "neon": {
        "command": "npx",
        "args": [
          "-y",
          "@neondatabase/mcp-server-neon",
          "start",
          "napi_hl788zvsh2bw6s28i1eg9wan2kxrurjdhy01nwk5gv2xkq9b24pjzi9cksada9e2"
        ]
      },
      "browser-tools": {
        "command": "npx",
        "args": [
          "-y",
          "@agentdeskai/browser-tools-mcp@1.2.0"
        ]
      }
    }
  }